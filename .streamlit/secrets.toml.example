# For Streamlit Community Cloud: paste the lines you need into App settings > Secrets.
# Locally you can use .env instead. Never commit a real secrets.toml.
# Ollama can't run on Streamlit Cloud, so use cloud providers there.

# Free cloud demo: Groq answers, Gemini indexes the documents
GROQ_API_KEY = "gsk_..."
GEMINI_API_KEY = "..."
EMBEDDING_PROVIDER = "gemini"

# Optional paid providers (each one adds itself to the model picker)
# OPENAI_API_KEY = "sk-..."
# ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: a second model checks every answer (one extra call per answer)
# JUDGE = "on"
# JUDGE_PROVIDER = "gemini"

# REPO_URL = "https://github.com/your-name/rag-chatbot"
