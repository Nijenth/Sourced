# Copy this file to .env and fill in what you use. Never commit .env.
#
# Two jobs, two settings:
#   - Embeddings index the documents for search (one provider at a time).
#   - Chat writes the answers (every provider with a key appears in the model picker).
# Changing EMBEDDING_PROVIDER or EMBEDDING_MODEL re-indexes the documents.

# ---- Which provider does what (optional) ----
# EMBEDDING_PROVIDER=openai   # default: the first one set up, in the order openai, gemini, ollama
# EMBEDDING_MODEL=            # default: that provider's recommended model
# CHAT_PROVIDER=anthropic     # put this one first in the model picker

# ---- OpenAI: chat + embeddings ----
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-terra

# ---- Anthropic: chat only ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Google Gemini: chat + embeddings (free tier available at aistudio.google.com) ----
# Free-tier requests may be used by Google to improve its products; use a paid key for client data.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_THINKING_LEVEL=low          # low / medium / high, or off for Gemini 2.5 models
# GEMINI_EMBEDDING_DIMENSIONS=768    # 768, 1536 or 3072

# ---- GroqCloud: very fast chat only (free tier at console.groq.com); pair with Gemini or Ollama embeddings ----
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b    # or openai/gpt-oss-20b (faster)
# GROQ_REASONING_EFFORT=low         # low / medium / high

# ---- Ollama: chat + embeddings on your own computer (free, private, no limits) ----
# Setting OLLAMA_MODEL turns Ollama on. Download models first, e.g.: ollama pull nomic-embed-text
# OLLAMA_MODEL=qwen3.6:35b-a3b-q4_K_M
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_THINK=false        # false is faster; true or auto lets thinking models reason first
# OLLAMA_NUM_CTX=8192       # context window in tokens
# OLLAMA_TIMEOUT=300        # seconds; big local models can be slow to load
# For Ollama embeddings: EMBEDDING_PROVIDER=ollama and EMBEDDING_MODEL=nomic-embed-text

# ---- App settings ----
# TOP_K=5
# RETRIEVAL_MODE=hybrid     # hybrid (keywords + meaning), dense (meaning only) or bm25 (keywords only)
# RERANKER=cross-encoder    # default; local and free, downloads an ~80 MB model once. Set none to turn it off.
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_POOL=20            # how many passages to rerank before keeping the best TOP_K
# JUDGE=off                 # on: a second model checks every answer against its passages (one extra call each)
# JUDGE_PROVIDER=           # which provider judges, e.g. groq; ideally not the one that wrote the answer
# JUDGE_ACTION=warn         # warn: show the verdict; block: hide answers judged unsupported

# Public demo: set ALLOW_UPLOADS=off to offer only the fictional handbook (recommended for a shared link)
# ALLOW_UPLOADS=on

# Demo limits that protect your API bill
# MAX_QUESTIONS_PER_SESSION=25
# MAX_QUESTIONS_PER_DAY=300
# MAX_UPLOAD_FILES=3
# MAX_UPLOAD_MB=10
# MAX_UPLOAD_PAGES=80

# Shown as a link in the sidebar
# REPO_URL=https://github.com/Nijenth/sourced

# Run with keyword matching instead of AI (no keys needed, for testing only)
# RAG_OFFLINE_MODE=1

# ---- Sourced API and ingestion worker ----
# Set to a postgresql+psycopg URL for the provisioned Sourced database.
# SOURCED_DATABASE_URL=
# SOURCED_MAX_PDF_CHARS=500000
# SOURCED_PDF_TIMEOUT_SECONDS=20
# Largest request body the API accepts, in bytes, except PDF uploads (those use MAX_UPLOAD_MB)
# SOURCED_MAX_BODY_BYTES=65536
# Address-space limit for the PDF reader process on Linux (no effect on Windows)
# SOURCED_PDF_MEMORY_MB=1024
# How many PDF readers may run at once (uploads, page pictures, highlights); others wait their turn
# SOURCED_PDF_CONCURRENCY=2
# Per-workspace limits, checked before an upload is read or saved
# SOURCED_WORKSPACE_MAX_DOCUMENTS=100
# SOURCED_WORKSPACE_MAX_STORAGE_MB=250
# SOURCED_WORKSPACE_MAX_PENDING=5
# Uploads waiting to be processed across the whole server
# SOURCED_MAX_PENDING_DOCUMENTS=25
# Base delay before retrying an upload after a temporary embedding failure (doubles each attempt)
# SOURCED_INGEST_RETRY_SECONDS=30
# How often the worker deletes expired sign-in sessions and rate-limit windows
# SOURCED_CLEANUP_SECONDS=600
# Sign-in protection (per 15 minutes) and new accounts per network (per hour)
# SOURCED_LOGIN_ATTEMPTS_PER_EMAIL=10
# SOURCED_LOGIN_ATTEMPTS_PER_IP=50
# SOURCED_SIGNUPS_PER_IP=10

# Website widget and hosted chat. Set the external origin that serves the public API and widget assets.
# SOURCED_PUBLIC_ORIGIN=https://chat.example.com
# SOURCED_DASHBOARD_ORIGIN=https://admin.example.com
# SOURCED_PREVIEW_SECRET=
# SOURCED_WIDGET_REQUESTS_PER_MINUTE=20
# SOURCED_IP_REQUESTS_PER_MINUTE=10
# SOURCED_TRUSTED_PROXIES=
# SOURCED_WORKSPACE_QUESTIONS_PER_DAY=300
# SOURCED_DEMO_SITE_KEY=
