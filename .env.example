# Copy this file to .env and fill in your keys. Never commit .env.

# Required: used to index documents (embeddings), and for answers if you pick OpenAI.
OPENAI_API_KEY=

# Optional: add this to answer with Claude. With both keys set, the app lets you switch.
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-6.1-terra
# EMBEDDING_MODEL=text-embedding-3-small
# TOP_K=5

# Demo limits that protect your API bill
# MAX_QUESTIONS_PER_SESSION=25
# MAX_QUESTIONS_PER_DAY=300
# MAX_UPLOAD_FILES=3
# MAX_UPLOAD_MB=10
# MAX_UPLOAD_PAGES=80

# Shown as a link in the sidebar
# REPO_URL=https://github.com/your-name/rag-chatbot

# Run the interface with keyword matching instead of AI (no keys needed, for UI work only)
# RAG_OFFLINE_MODE=1
